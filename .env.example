# Career Connect Pro — Environment Configuration Blueprint
# Copy this file to .env.local or .env for local development

# Application Metadata
VITE_APP_NAME="Career Connect Pro"
VITE_APP_VERSION="2.0.0-PROD"
VITE_APP_ENV="development"

# API & Gateway Configuration (Optional - Defaults to embedded mock datasets)
VITE_API_BASE_URL="https://api.careerconnectpro.in/v1"
VITE_API_TIMEOUT_MS=15000

# Feature Toggles
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MOCK_LATENCY=true
VITE_DEFAULT_PERSONA="candidate" # Options: candidate | recruiter | admin | developer

# AI Screening Service Configuration
VITE_AI_SCREENING_ENDPOINT="https://api.careerconnectpro.in/ai/v1/screen"
VITE_AI_MONTHLY_CREDIT_CAP=50000

# Security & Compliance
VITE_ENABLE_SUDO_STEP_UP=true
VITE_SESSION_TIMEOUT_MINUTES=30

